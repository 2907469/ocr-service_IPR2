NODE_ENV=development
PORT=3000
# Пусто = данные хранятся в памяти (удобно для локального запуска). Для Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Разрешённые origin фронтенда через запятую
CORS_ORIGIN=http://localhost:5173
MAX_FILE_MB=5
RATE_LIMIT_PER_MIN=20
# Sentry
SENTRY_DSN=
# Better Stack Logs (Logtail): source token и (для новых источников) ingesting host, например https://sXXXX.eu-nbg-2.betterstackdata.com
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_ENDPOINT=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_START=false
# Токен для служебного /debug-sentry (любая длинная случайная строка)
ADMIN_TOKEN=
